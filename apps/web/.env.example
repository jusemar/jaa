# Variáveis PÚBLICAS: são embutidas no JavaScript NA HORA DO BUILD. Mudou o valor na hospedagem? Só
# vale depois de um novo build/deploy. Localmente ficam em apps/web/.env.local (fora do Git).
#
# PRODUÇÃO (hospedagem da Web, ambiente Production): NEXT_PUBLIC_API_URL e NEXT_PUBLIC_MAPBOX_TOKEN
# são OBRIGATÓRIAS — sem elas o build de produção é recusado (src/lib/ambiente-de-producao.ts) e a
# publicação anterior continua no ar.

# Endereço da API. Local: http://localhost:3333. Produção: o endereço HTTPS público da API.
NEXT_PUBLIC_API_URL=http://localhost:3333
# Token público (pk.*) do Mapbox GL JS (mapas de rota, entrega, zonas e ponto). Sem ele, local, os
# mapas de rota/entrega ficam indisponíveis e os de ponto caem no Leaflet/OSM.
# O MAPBOX_TOKEN da API continua exclusivo do servidor para Geocoding/Directions.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Endereço HTTPS oficial do APK: o do armazenamento público (R2), terminando em /app/android/jaaa.apk
# — é o que `npm run app:publicar-apk -w @jaa/api` informa ao final. O navegador baixa direto de lá.
# Vazio mantém "Download em breve" na landing.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
