NEXT_PUBLIC_API_URL=http://localhost:3333
# Token público (pk.*) restrito aos domínios do Web, usado somente pelo Mapbox GL JS.
# O MAPBOX_TOKEN da API continua exclusivo do servidor para Geocoding/Directions.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Endereço HTTPS oficial do APK: o do armazenamento público (R2), terminando em /app/android/jaaa.apk
# — é o que `npm run app:publicar-apk -w @jaa/api` informa ao final. O navegador baixa direto de lá.
# Vazio mantém "Download em breve" na landing.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
