# Somente servidor. Nunca expor ao mobile ou ao web.

NODE_ENV=development

# PostgreSQL local do docker-compose.yml da raiz.
DATABASE_URL=postgres://jaa:jaa_dev_local@127.0.0.1:55433/jaa

# Segredo de assinatura das sessões (mínimo 32 caracteres). Gere um valor próprio:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública desta API.
BETTER_AUTH_URL=http://localhost:3333

# Origens do web autorizadas (CORS e trustedOrigins do Better Auth), separadas por vírgula.
ORIGENS_WEB_PERMITIDAS=http://localhost:3000,http://localhost:3001

# Entrega do código OTP. "desenvolvimento" exibe o código no terminal da API
# e é recusado quando NODE_ENV=production. Nenhum SMS é enviado.
OTP_ENTREGA=desenvolvimento

# OPCIONAL — geocodificação do endereço (só para SUGERIR onde abrir o mapa; nunca confirma o ponto
# nem altera o endereço digitado pelo cliente). Sem esta URL, nenhum serviço externo é chamado.
# Espera uma API compatível com a busca do Nominatim/OpenStreetMap (sem chave, sem cobrança).
# Respeite a política de uso do serviço escolhido antes de ativar em produção.
# GEOCODIFICACAO_URL=https://nominatim.openstreetmap.org/search
# GEOCODIFICACAO_CONTATO=contato@exemplo.com.br
