# Somente servidor. Nunca expor ao mobile ou ao web.

NODE_ENV=development

# PostgreSQL local do docker-compose.yml da raiz.
DATABASE_URL=postgres://jaa:jaa_dev_local@127.0.0.1:55433/jaa

# Segredo de assinatura das sessões (mínimo 32 caracteres). Gere um valor próprio:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública desta API.
BETTER_AUTH_URL=http://localhost:3333

# Origens do web autorizadas (CORS e trustedOrigins do Better Auth), separadas por vírgula.
ORIGENS_WEB_PERMITIDAS=http://localhost:3000,http://localhost:3001

# Entrega do código OTP. "desenvolvimento" exibe o código no terminal da API
# e é recusado quando NODE_ENV=production. Nenhum SMS é enviado.
OTP_ENTREGA=desenvolvimento

# OPCIONAL — geocodificação do endereço (só para SUGERIR onde abrir o mapa; nunca confirma o ponto
# nem altera o endereço digitado pelo cliente). Sem esta URL, nenhum serviço externo é chamado.
# Espera uma API compatível com a busca do Nominatim/OpenStreetMap (sem chave, sem cobrança).
# Respeite a política de uso do serviço escolhido antes de ativar em produção.
# GEOCODIFICACAO_URL=https://nominatim.openstreetmap.org/search
# GEOCODIFICACAO_CONTATO=contato@exemplo.com.br

# OPCIONAL — motor de rotas real (Mapbox é o primeiro provedor). Sem o token, o Jaa NÃO chama
# serviço externo: a sequência continua saindo da aproximação local e nenhuma distância, duração ou
# traçado é inventado. O token é segredo de servidor e jamais deve ir para o web ou o mobile.
# Revise os termos do provedor antes de usar em produção (inclusive quanto a exibir a rota sobre
# mapas de outro fornecedor).
# MAPBOX_TOKEN=
# MAPBOX_URL=https://api.mapbox.com

# OPCIONAL — armazenamento de arquivos (foto de perfil, logo da empresa, imagem de produto) no
# Cloudflare R2. Sem estas variáveis o Jaa NÃO inventa bucket nem URL: o upload é recusado com aviso
# claro e o resto do produto continua funcionando (o avatar cai nas iniciais do nome).
# Preencha as quatro primeiras juntas, ou nenhuma. As chaves são SEGREDO DE SERVIDOR: nunca vão para
# o web nem para o mobile — todo upload passa pela API, que valida tipo, tamanho e autorização.
# R2_CONTA_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Domínio público de leitura do bucket (r2.dev ou domínio próprio). Sem ele as imagens não têm URL.
# R2_URL_PUBLICA=
# Endpoint alternativo; por padrão https://<R2_CONTA_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
