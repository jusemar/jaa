{
  "name": "@jaa/banco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/conexao.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gerar-migration": "drizzle-kit generate",
    "migrar": "drizzle-kit migrate",
    "verificar-migrations": "drizzle-kit check",
    "verificar-conexao": "tsx --env-file-if-exists=.env scripts/verificar-conexao.ts",
    "semear-montagem": "tsx --env-file-if-exists=.env scripts/semear-montagem-local.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  }
}
